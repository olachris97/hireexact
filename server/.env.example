# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hireexact
DATABASE_SSL=false

# Set to true if connecting to a managed Postgres (Render, Supabase, RDS, etc.) requiring SSL
# DATABASE_SSL=true

PORT=4000

# CORS: the URL your frontend runs on
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign admin JWTs — set a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Optional: enables the AI Talent Matcher to call Gemini. Without it, a graceful fallback response is used.
GEMINI_API_KEY=

# Used only by `npm run seed` to create the first admin login
SEED_ADMIN_EMAIL=admin@hireexact.com
SEED_ADMIN_PASSWORD=ChangeMe123!
